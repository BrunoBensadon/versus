# Secrets — never commit
.env
.env.*
!.env.example

# Token caches
*.token
.token-cache*
spikes/.cache/

# Raw API dumps (only trimmed, secret-free fixtures in spikes/fixtures/ are committed)
spikes/raw/
*.raw.json

# Python
__pycache__/
*.pyc
.venv/

# Node
node_modules/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Build output and local tool state
dist/
.wrangler/
coverage/
test-results/
playwright-report/

# Local Worker secrets (copied from .env, never committed)
.dev.vars
.dev.vars.*

# Exports hold personal data (rankings, playtimes): never commit them to this PUBLIC repo
exports/
*.export.json
